# Frontend Vercel project (root directory: frontend/) — Settings → Environment Variables.
# Placeholders only: paste the real values in the Vercel dashboard, never in this file.

# URL of the backend Vercel project (Settings → Domains of that project), without trailing slash.
BACKEND_URL=https://<backend-project>.vercel.app
# Same value as PROXY_SHARED_SECRET in the backend project. Server-only: never prefix it with NEXT_PUBLIC_.
PROXY_SHARED_SECRET=<same-random-value-as-the-backend>
# Same value as MAX_UPLOAD_BYTES in the backend project (Vercel request body limit: 4.5 MB).
NEXT_PUBLIC_MAX_UPLOAD_BYTES=4000000
