# Backend Vercel project (root directory: backend/) — Settings → Environment Variables.
# Placeholders only: paste the real values in the Vercel dashboard, never in this file.

APP_ENV=production
LOG_LEVEL=INFO
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<random-64-characters>

# Serverless profile: no Redis, no Celery worker, no ClamAV.
TASK_MODE=inline
EPHEMERAL_STORE=postgres
ANTIVIRUS=none
DB_POOL=null
IMAP_HOST=
AI_PROVIDER=none

# Same value as in the frontend project: the API refuses any call that does not come through the proxy.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
PROXY_SHARED_SECRET=<random-64-characters>

# Supabase → Connect → "Session pooler" (port 5432), with the +asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase → Storage → S3 Connection (create a PRIVATE bucket "studentdocs" first, then an S3 access key).
S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=<region, e.g. eu-west-3>
S3_ACCESS_KEY=<supabase-s3-access-key-id>
S3_SECRET_KEY=<supabase-s3-secret-access-key>
S3_BUCKET=studentdocs
S3_FORCE_PATH_STYLE=true

# Public site (the frontend domain).
FRONTEND_URL=https://<your-domain>
CORS_ORIGINS=["https://<your-domain>"]
COOKIE_SECURE=true
TRUSTED_PROXIES=[]

# Vercel refuses request bodies above 4.5 MB: keep uploads at 4 MB (same value as the frontend).
MAX_UPLOAD_BYTES=4000000

# Brevo → SMTP & API → SMTP (login and SMTP key). The sender must be a verified Brevo sender / domain.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=<brevo-smtp-login>
SMTP_PASSWORD=<brevo-smtp-key>
MAIL_FROM=StudentDocs <scolarite@your-domain>
