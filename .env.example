# Copy to .env and replace every value. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-random-48-byte-value-xxxxxxxxxxxx
CORS_ORIGINS=["http://localhost:3000"]

POSTGRES_USER=studentdocs
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=studentdocs

# S3-compatible storage (SeaweedFS locally, any S3 provider in production).
S3_REGION=us-east-1
S3_ACCESS_KEY=studentdocs
S3_SECRET_KEY=replace-me-too
S3_BUCKET=studentdocs

# Public URL of the web app (links in emails).
FRONTEND_URL=http://localhost:3000

# Development seed. Demo accounts (superadmin@univ-demo.ma, admin@univ-demo.ma,
# etudiant@<domain>) are only created when SEED_DEMO_PASSWORD is set (min 12 chars, letters + digits).
SEED_STUDENT_EMAIL_DOMAIN=etu.univ-demo.ma
SEED_DEMO_PASSWORD=

# Brute-force protection (per client IP). Login: per minute; registration: per hour.
# Raise the registration limit locally when running the E2E suite repeatedly.
RATE_LIMIT_LOGIN_PER_IP=20
RATE_LIMIT_REGISTER_PER_IP=10
